include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/WingLuauQtPython.cmake")
set(_WINGLUAUQT_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")
cmake_path(NORMAL_PATH _WINGLUAUQT_ROOT)
string(REGEX REPLACE "/+$" "" _WINGLUAUQT_ROOT "${_WINGLUAUQT_ROOT}")

# Generate at configure time so add_subdirectory always sees complete sources.
function(wingluauqt_generate)
  cmake_parse_arguments(PARSE_ARGV 0 ARG "" "CONFIG;OUTPUT_DIR;ROOT;DRIVER;DRIVER_CONFIG" "DEPENDS")
  if(ARG_UNPARSED_ARGUMENTS OR NOT ARG_CONFIG OR NOT ARG_OUTPUT_DIR OR NOT ARG_ROOT)
    message(FATAL_ERROR "wingluauqt_generate requires CONFIG, OUTPUT_DIR and ROOT")
  endif()
  wingluauqt_prepare_python()
  get_filename_component(_root "${ARG_ROOT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  get_filename_component(_config "${ARG_CONFIG}" ABSOLUTE BASE_DIR "${_root}")
  get_filename_component(_output "${ARG_OUTPUT_DIR}" ABSOLUTE BASE_DIR "${_root}")
  set(_command "${Python3_EXECUTABLE}" -m qtluau_codegen.project --config "${_config}" --out "${_output}" --root "${_root}")
  if(ARG_DRIVER)
    get_filename_component(_driver "${ARG_DRIVER}" ABSOLUTE BASE_DIR "${_root}")
    set(_command "${Python3_EXECUTABLE}" "${_driver}" --config "${_config}" --out "${_output}" --host "${_root}")
    if(ARG_DRIVER_CONFIG)
      get_filename_component(_driver_config "${ARG_DRIVER_CONFIG}" ABSOLUTE BASE_DIR "${_root}")
      list(APPEND _command --project "${_driver_config}")
    endif()
  endif()
  file(GLOB_RECURSE _framework_inputs CONFIGURE_DEPENDS
    "${_WINGLUAUQT_ROOT}/python/qtluau_codegen/*.py"
    "${_WINGLUAUQT_ROOT}/config/*.json"
    "${_WINGLUAUQT_ROOT}/include/qtluau/*.hpp"
    "${_WINGLUAUQT_ROOT}/support/*.cpp"
    "${_WINGLUAUQT_ROOT}/support/qt/*.cpp"
    "${_WINGLUAUQT_ROOT}/support/bindings/*")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_config}" ${_driver} ${_driver_config} ${ARG_DEPENDS} ${_framework_inputs})
  if(EXISTS "${_WINGLUAUQT_ROOT}/python")
    set(_command "${CMAKE_COMMAND}" -E env "PYTHONPATH=${_WINGLUAUQT_ROOT}/python" ${_command})
  elseif(WINGLUAUQT_PYTHON_PACKAGE_ROOT)
    # Append the installed framework after this venv's dependencies, so an older
    # tsujikiri in the caller's site-packages cannot shadow the validated version.
    list(REMOVE_AT _command 0)
    set(_launcher "import runpy, sys
sys.path.append(sys.argv.pop(1))
entry = sys.argv.pop(1)
if entry == '-m':
    runpy.run_module(sys.argv.pop(1), run_name='__main__', alter_sys=True)
else:
    runpy.run_path(entry, run_name='__main__')")
    set(_command "${Python3_EXECUTABLE}" -c "${_launcher}" "${WINGLUAUQT_PYTHON_PACKAGE_ROOT}" ${_command})
  endif()
  execute_process(COMMAND ${_command} RESULT_VARIABLE _result)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "WingLuauQt generation failed; see generator diagnostics above")
  endif()
  set(_wingluauqt_input_root "${_root}")
  include("${_output}/generation_inputs.cmake")
endfunction()

# Configure a host target from its generation policy. Native implementation
# stays in the host; this function owns generation, linking and deployment.
function(wingluauqt_integrate)
  cmake_parse_arguments(PARSE_ARGV 0 ARG "" "TARGET;CONFIG;OUTPUT_DIR;ROOT" "")
  if(ARG_UNPARSED_ARGUMENTS OR NOT ARG_TARGET OR NOT TARGET "${ARG_TARGET}" OR NOT ARG_CONFIG)
    message(FATAL_ERROR "wingluauqt_integrate requires an existing TARGET and CONFIG")
  endif()
  if(NOT ARG_ROOT)
    set(ARG_ROOT "${CMAKE_SOURCE_DIR}")
  endif()
  get_filename_component(_root "${ARG_ROOT}" ABSOLUTE)
  get_filename_component(_project "${ARG_CONFIG}" ABSOLUTE BASE_DIR "${_root}")
  get_filename_component(_configuration_dir "${_project}" DIRECTORY)
  file(READ "${_project}" _settings)
  string(JSON _bindings GET "${_settings}" bindings)
  string(JSON _output GET "${_settings}" output)
  string(JSON _driver GET "${_settings}" driver)
  get_filename_component(_bindings "${_bindings}" ABSOLUTE BASE_DIR "${_configuration_dir}")
  if(ARG_OUTPUT_DIR)
    set(_output "${ARG_OUTPUT_DIR}")
  endif()
  get_filename_component(_output "${_output}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
  string(JSON _dependencies GET "${_settings}" dependencies)
  string(JSON _count LENGTH "${_dependencies}")
  set(_inputs "${_project}" "${_bindings}")
  if(_count GREATER 0)
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
      string(JSON _pattern GET "${_dependencies}" ${_index})
      file(GLOB_RECURSE _matches CONFIGURE_DEPENDS "${_root}/${_pattern}")
      list(APPEND _inputs ${_matches})
    endforeach()
  endif()
  wingluauqt_generate(CONFIG "${_bindings}" OUTPUT_DIR "${_output}"
    ROOT "${_root}" DRIVER "${_driver}" DRIVER_CONFIG "${_project}" DEPENDS ${_inputs})
  file(READ "${_output}/manifest.json" _manifest)
  string(JSON _name GET "${_manifest}" name)
  set(${_name}_HOST_SOURCE_DIR "${_root}" CACHE PATH "Binding host source root")
  string(JSON _native_sources GET "${_settings}" cmake native_sources)
  string(JSON _count LENGTH "${_native_sources}")
  if(_count GREATER 0)
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
      string(JSON _variable MEMBER "${_native_sources}" ${_index})
      string(JSON _path GET "${_native_sources}" "${_variable}")
      get_filename_component(_path "${_path}" ABSOLUTE BASE_DIR "${_root}")
      set(${_variable} "${_path}" CACHE PATH "Native binding dependency source")
    endforeach()
  endif()
  add_subdirectory("${_output}" "${CMAKE_BINARY_DIR}/luau-bindings")
  target_link_libraries("${ARG_TARGET}" PRIVATE "${_name}::Bindings")
  string(JSON _includes GET "${_settings}" cmake registration_includes)
  string(JSON _count LENGTH "${_includes}")
  if(_count GREATER 0)
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
      string(JSON _macro MEMBER "${_includes}" ${_index})
      string(JSON _default GET "${_includes}" "${_macro}")
      set(${_macro} "${_default}" CACHE STRING "Host registration include")
      target_compile_definitions("${ARG_TARGET}" PRIVATE "${_macro}=\"${${_macro}}\"")
    endforeach()
  endif()
  cmake_language(CALL "${_name}_copy_definitions" "${ARG_TARGET}")
  get_target_property(_definition_sources "${_name}" QTLUAU_DEFINITION_SOURCES)
  file(GLOB _definition_files CONFIGURE_DEPENDS "${_definition_sources}/*.d.luau"
    "${_definition_sources}/*_symbols*.json")
  if(IS_ABSOLUTE "${${_name}_DEFINITIONS_DIR}")
    set(_destination "${${_name}_DEFINITIONS_DIR}")
  elseif(APPLE)
    get_target_property(_executable "${ARG_TARGET}" OUTPUT_NAME)
    if(NOT _executable)
      set(_executable "${ARG_TARGET}")
    endif()
    set(_destination "${_executable}.app/Contents/MacOS/${${_name}_DEFINITIONS_DIR}")
  else()
    set(_destination "${${_name}_DEFINITIONS_DIR}")
  endif()
  install(FILES ${_definition_files} DESTINATION "${_destination}" COMPONENT LuauDefinitions)
endfunction()
