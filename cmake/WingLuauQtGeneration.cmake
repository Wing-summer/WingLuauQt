include_guard(GLOBAL)
option(WINGLUAUQT_FORCE_GENERATION "Regenerate bindings even when inputs are unchanged" OFF)

# Hash content rather than timestamps: touching a header must not rescan the SDK.
function(_wingluauqt_fingerprint result)
  set(_files ${ARGN})
  list(REMOVE_DUPLICATES _files)
  list(SORT _files)
  set(_content)
  foreach(_file IN LISTS _files)
    if(EXISTS "${_file}" AND NOT IS_DIRECTORY "${_file}")
      file(SHA256 "${_file}" _hash)
    else()
      set(_hash missing)
    endif()
    string(APPEND _content "${_file}:${_hash}\n")
  endforeach()
  string(SHA256 _signature "${_content}")
  set(${result} "${_signature}" PARENT_SCOPE)
endfunction()

# Query the scanning SDK as well as the consuming CMake SDK. Both can change
# without a binding policy edit (for example after a package-manager upgrade).
function(_wingluauqt_sdk_inputs files identity)
  set(_roots ${Qt6Core_INCLUDE_DIRS} ${Qt6Gui_INCLUDE_DIRS} ${Qt6Widgets_INCLUDE_DIRS})
  set(_identity "${Qt6_DIR}|${Qt6_VERSION}|${Python3_EXECUTABLE}|${Python3_VERSION}|${CMAKE_CXX_COMPILER}|${CMAKE_CXX_COMPILER_VERSION}")
  unset(_wingluauqt_pkg_config CACHE)
  find_program(_wingluauqt_pkg_config NAMES pkg-config PATHS ENV PATH NO_DEFAULT_PATH)
  if(_wingluauqt_pkg_config)
    execute_process(COMMAND "${_wingluauqt_pkg_config}" --cflags Qt6Core Qt6Gui Qt6Widgets
      RESULT_VARIABLE _status OUTPUT_VARIABLE _flags ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(_status EQUAL 0)
      string(APPEND _identity "|${_flags}")
      separate_arguments(_flags NATIVE_COMMAND "${_flags}")
      foreach(_flag IN LISTS _flags)
        if(_flag MATCHES "^-I(.+)$")
          list(APPEND _roots "${CMAKE_MATCH_1}")
        endif()
      endforeach()
    endif()
  endif()
  list(REMOVE_DUPLICATES _roots)
  set(_inputs)
  foreach(_root IN LISTS _roots)
    file(GLOB_RECURSE _headers CONFIGURE_DEPENDS "${_root}/*.h" "${_root}/*.hpp")
    list(APPEND _inputs ${_headers})
  endforeach()
  unset(_wingluauqt_clang CACHE)
  find_program(_wingluauqt_clang NAMES clang++ PATHS ENV PATH NO_DEFAULT_PATH)
  if(_wingluauqt_clang)
    list(APPEND _inputs "${_wingluauqt_clang}")
  endif()
  foreach(_variable PATH PYTHONPATH PKG_CONFIG_PATH PKG_CONFIG_LIBDIR PKG_CONFIG_SYSROOT_DIR
      QT_SELECT QTDIR SDKROOT CPATH CPLUS_INCLUDE_PATH LIBCLANG_PATH)
    string(APPEND _identity "|${_variable}=$ENV{${_variable}}")
  endforeach()
  set(${files} "${_inputs}" PARENT_SCOPE)
  set(${identity} "${_identity}" PARENT_SCOPE)
endfunction()

# A successful checkpoint covers inputs and generated content. Missing or
# modified artifacts trigger regeneration, while unrelated host edits do not.
function(wingluauqt_cached_generation)
  cmake_parse_arguments(PARSE_ARGV 0 ARG "" "OUTPUT_DIR;ROOT;WATCH_FILE" "COMMAND;INPUTS;OUTPUT_GLOBS;INPUT_LIST_FILES")
  if(ARG_UNPARSED_ARGUMENTS OR NOT ARG_OUTPUT_DIR OR NOT ARG_ROOT OR NOT ARG_COMMAND)
    message(FATAL_ERROR "wingluauqt_cached_generation requires OUTPUT_DIR, ROOT and COMMAND")
  endif()
  get_filename_component(_parent "${ARG_OUTPUT_DIR}" DIRECTORY)
  get_filename_component(_name "${ARG_OUTPUT_DIR}" NAME)
  file(MAKE_DIRECTORY "${_parent}")
  file(LOCK "${_parent}/.${_name}.configure.lock" GUARD FUNCTION TIMEOUT 300)
  set(_state "${_parent}/.${_name}.configure.sha256")
  _wingluauqt_sdk_inputs(_sdk_inputs _identity)
  set(_base_inputs ${ARG_INPUTS} ${_sdk_inputs} "${Python3_EXECUTABLE}"
    "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_base_inputs})
  string(APPEND _identity "|${ARG_ROOT}|${ARG_COMMAND}")
  foreach(_phase check save)
    set(_inputs ${_base_inputs})
    set(_outputs)
    foreach(_list IN LISTS ARG_INPUT_LIST_FILES)
      if(EXISTS "${_list}")
        file(STRINGS "${_list}" _listed_inputs)
        list(APPEND _inputs ${_listed_inputs})
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_listed_inputs})
      endif()
    endforeach()
    if(ARG_WATCH_FILE AND EXISTS "${ARG_WATCH_FILE}")
      set(_wingluauqt_input_root "${ARG_ROOT}")
      unset(_wingluauqt_generation_inputs)
      unset(_wingluauqt_generation_outputs)
      include("${ARG_WATCH_FILE}")
      list(APPEND _inputs ${_wingluauqt_generation_inputs})
      list(APPEND _outputs ${_wingluauqt_generation_outputs})
    endif()
    foreach(_pattern IN LISTS ARG_OUTPUT_GLOBS)
      file(GLOB_RECURSE _matches LIST_DIRECTORIES false "${_pattern}")
      list(APPEND _outputs ${_matches})
    endforeach()
    set(_complete true)
    foreach(_file IN LISTS _outputs)
      if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}")
        set(_complete false)
      endif()
    endforeach()
    _wingluauqt_fingerprint(_input_hash ${_inputs})
    _wingluauqt_fingerprint(_output_hash ${_outputs})
    string(SHA256 _signature "v1|${_identity}|${_input_hash}|${_output_hash}")
    if(_phase STREQUAL check)
      if(NOT WINGLUAUQT_FORCE_GENERATION AND _complete AND _outputs AND EXISTS "${_state}")
        file(READ "${_state}" _previous)
        if(_previous STREQUAL _signature)
          message(STATUS "WingLuauQt: reusing generated bindings in ${ARG_OUTPUT_DIR}")
          return()
        endif()
      endif()
      set(_observed_inputs ${_inputs})
      execute_process(COMMAND ${ARG_COMMAND} RESULT_VARIABLE _result)
      if(NOT _result EQUAL 0)
        message(FATAL_ERROR "WingLuauQt generation failed; see generator diagnostics above")
      endif()
      _wingluauqt_fingerprint(_current_hash ${_observed_inputs})
      if(NOT _current_hash STREQUAL _input_hash)
        file(REMOVE "${_state}")
        message(STATUS "WingLuauQt inputs changed during generation; checkpoint discarded")
        return()
      endif()
    else()
      if(NOT _outputs OR NOT _complete)
        message(FATAL_ERROR "WingLuauQt generator did not publish its output inventory")
      endif()
      file(WRITE "${_state}.tmp" "${_signature}")
      file(RENAME "${_state}.tmp" "${_state}")
    endif()
  endforeach()
endfunction()
