--!strict
local window = qt.QWidget()
assert(not pcall(function() (window :: any).show() end))
assert(not pcall(function() (window :: any).show(nil) end))
window:set_object_name("editor-window")
window:set_window_title("Luau text editor")
assert((window :: any).set_accessible_identifier == nil)
window:resize(600, 400)
local layout = qt.QVBoxLayout()
window:set_layout(layout)
local bar = qt.QMenuBar()
bar:set_object_name("editor-menu")
layout:add_widget(bar)
local file = bar:add_menu("File")
file:set_object_name("file-menu")
local text = qt.QTextEdit()
assert(not pcall(function() (text :: any).to_plain_text() end))
text:set_object_name("editor-text")
layout:add_widget(text)
local status = qt.QLabel("Ready")
status:set_object_name("editor-status")
layout:add_widget(status)
file:add_action("New"):connect("triggered", function()
    text:clear()
    status:set_text("New document")
end)
file:add_action("Sample"):connect("triggered", function()
    text:set_plain_text("Hello from Luau")
    status:set_text("Sample inserted")
end)
file:add_action("Close"):connect("triggered", function()
    window:close()
end)
window:show()
-- The close callback retains the root until the host clears Lua callbacks.
