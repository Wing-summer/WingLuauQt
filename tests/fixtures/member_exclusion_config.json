{
  "common": {
    "types": {
      "QString": {
        "alias": "ustring"
      },
      "QByteArray": {
        "alias": "bytearray"
      }
    }
  },
  "qt": {
    "namespace": "qt",
    "widgets": {
      "include": [
        "QWidget",
        "QPushButton"
      ],
      "extra_types": [],
      "expose_qwidget_base": true,
      "hide_unselected": true,
      "dependency_api": "minimal"
    }
  },
  "exclude": {
    "classes": [
      "QMainWindow",
      "QDialog",
      "QDockWidget",
      "QFile",
      "QThread",
      "QProcess",
      "QLibrary",
      "QPluginLoader",
      "QOpenGLWidget",
      "QApplication",
      "QGuiApplication",
      "QCoreApplication"
    ],
    "members": [
      "QPushButton::click",
      "QPushButton::new(QString)",
      "QWidget::setStyleSheet"
    ]
  },
  "lsp": {
    "variadic_fixture": false
  }
}
